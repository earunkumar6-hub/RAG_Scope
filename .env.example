# RAGScope — copy to .env and fill in. API keys are read ONLY from the environment.

APP_ENV=development
LOG_LEVEL=INFO
# DATA_DIR=./backend/data          # SQLite, Chroma, runtime_config.json, NetworkX graph
CORS_ORIGINS=http://localhost:3000  # comma-separated

# --- LLM: generation, KG extraction, guardrail classifier, eval judges ---
# Only the OpenAI adapter is implemented. OPENAI_BASE_URL can point it at an OpenAI-compatible
# gateway (untested with other servers).
LLM_PROVIDER=openai

OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini          # main generation model; verify against your account
OPENAI_MODEL_FAST=gpt-4.1-mini     # KG extraction, classifiers, judges

# --- Embeddings / reranker / tokenizer (local by default, independent of LLM_PROVIDER) ---
EMBEDDING_PROVIDER=local           # local | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RERANKER_MODEL=BAAI/bge-reranker-base
TOKENIZER_ENCODING=cl100k_base

# --- Stores ---
CHROMA_COLLECTION=chunks
# Knowledge graph: Neo4j when NEO4J_URI is set, otherwise NetworkX (JSON in DATA_DIR).
# docker compose defaults NEO4J_URI to its neo4j service (bolt://neo4j:7687); uncomment with an
# empty value to use NetworkX there. Outside Docker it is unset unless you set it here.
# NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag-dev        # also the compose neo4j service's password (min 8 chars)
